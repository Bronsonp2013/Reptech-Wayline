# Build context excludes — keep the image lean and force fresh installs/generates
# inside the linux container (host node_modules / generated client are wrong arch).
node_modules
.next
generated
.git
.env
.env.*
!.env.production.example
npm-debug.log*
tests
*.md
!README.md
Account List
*.csv
*.xlsx
.claude
scratchpad
.github
# `*.md` above doesn't catch these — they'd otherwise ride into the image via `COPY . .`.
*.txt
files.zip
*.tsbuildinfo
