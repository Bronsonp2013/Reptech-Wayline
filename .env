# Wayline — LOCAL DEV environment. This file is gitignored. Never commit real secrets.
# Copy from .env.example and fill in. The Postgres creds here match docker-compose.yml.

# --- Postgres (consumed by docker-compose.yml for the wayline-db container) ---
POSTGRES_USER=wayline
POSTGRES_PASSWORD=wayline_dev_pw
POSTGRES_DB=wayline

# --- App / Prisma ---
# localhost:5433 is the dev DB published by docker-compose (bound to 127.0.0.1 only).
# Port 5433 avoids a clash with another local Postgres already on 5432.
DATABASE_URL="postgresql://wayline:wayline_dev_pw@localhost:5433/wayline?schema=public"

# High-entropy secret for signing/session use (Session 1). >= 32 bytes.
SESSION_SECRET=98b0165bff21687bccfaa9a01634e66d502b4d569aaddd4b6b09b87da0e2d854

# --- Seed: Brian's single v1 user (read only by prisma/seed.ts) ---
SEED_USER_EMAIL=Bprachyl61@gmail.com
SEED_USER_PASSWORD=Bronsonp009
