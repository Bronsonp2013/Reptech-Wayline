# Wayline — environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored; this file (.env.example) is committed with placeholders only.

# --- Postgres (consumed by docker-compose.yml for the wayline-db container) ---
POSTGRES_USER=wayline
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wayline

# --- App / Prisma ---
# Host port 5433 (see docker-compose.yml) to avoid clashing with a local Postgres on 5432.
DATABASE_URL="postgresql://wayline:change_me@localhost:5433/wayline?schema=public"

# High-entropy secret (>= 32 bytes). Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_openssl_rand_hex_32

# --- Seed (npm run db:seed creates/updates the single v1 user, "Brian") ---
# Set these to real values before seeding; they are read only by prisma/seed.ts.
SEED_USER_EMAIL=brian@example.com
SEED_USER_PASSWORD=set_a_strong_password
# Optional overrides:
# SEED_USER_NAME=Brian
# SEED_USER_TZ=America/Chicago
