# Wayline PRODUCTION env template. On the NAS: copy to `.env.production` and fill
# in real secrets. NEVER commit the real file (it is gitignored).
# Generate secrets with:  openssl rand -hex 32

# --- Postgres (internal to the compose network; never published) ---
POSTGRES_USER=wayline
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=wayline

# --- App → DB. Host is the service name `wayline-db`, internal port 5432. ---
# The password here MUST match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://wayline:change_me_strong_db_password@wayline-db:5432/wayline?schema=public

# --- Session signing secret (>= 32 bytes). openssl rand -hex 32 ---
SESSION_SECRET=replace_with_openssl_rand_hex_32

# Enables Secure cookies + the production CSP (no unsafe-eval).
NODE_ENV=production

# --- Seeded user (run db:seed once after the first deploy) ---
SEED_USER_EMAIL=rep@example.com
SEED_USER_PASSWORD=set_a_strong_password

# --- Cloudflare Tunnel token ---
# Zero Trust dashboard → Networks → Tunnels → (your tunnel) → install/token.
TUNNEL_TOKEN=paste_the_cloudflare_tunnel_token_here
